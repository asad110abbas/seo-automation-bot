# ============================================================
# SEO Automation Bot — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Anthropic (REQUIRED) ---
ANTHROPIC_API_KEY=sk-ant-api03-...

# --- SEO Data APIs (REQUIRED) ---
SERPAPI_KEY=your_serpapi_key_here

# --- Google Business Profile (OPTIONAL) ---
# Get from: https://console.cloud.google.com/
GBP_API_KEY=

# --- Database ---
# For local dev without Docker: postgresql+asyncpg://postgres:postgres@localhost/seo_bot
# Docker sets this automatically via docker-compose.yml
DATABASE_URL=postgresql+asyncpg://seo:seo_pass@localhost/seo_bot

# --- Redis ---
# Docker sets this automatically via docker-compose.yml
REDIS_URL=redis://localhost:6379

# --- Application ---
SECRET_KEY=change-me-to-a-long-random-string-in-production
ENVIRONMENT=development
DEBUG=true

# --- CORS ---
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- File Storage ---
# For PDF reports: "local" stores in ./reports/ folder
STORAGE_BACKEND=local
REPORTS_DIR=./reports

# --- Rate Limiting ---
MAX_RUNS_PER_PROJECT_PER_DAY=10
